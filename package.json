{
  "name": "stickera",
  "version": "0.1.0-mvp",
  "private": true,
  "description": "Offline sticker album — PWA",
  "main": "expo-router/entry",
  "scripts": {
    "content:scaffold": "node scripts/content-scaffold.mjs",
    "content:sync-manifests": "node scripts/content-sync-manifests.mjs",
    "content:build": "node scripts/content-build.mjs",
    "sync:assets": "node scripts/sync-content-to-assets.mjs && node scripts/create-assets.mjs && node scripts/sync-pwa-icons.mjs",
    "prestart": "npm run sync:assets",
    "start": "expo start --web",
    "web": "expo start --web",
    "build:web": "node scripts/build-github-pages.mjs",
    "prebuild:web": "npm run sync:assets && node scripts/write-sw.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:structure:strict": "node scripts/validate-structure.mjs --strict",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "mvp:status": "node scripts/mvp-status.mjs",
    "hash:admin": "node scripts/hash-admin-code.mjs",
    "validate": "npm run validate:structure && npm run validate:content && npm run validate:i18n && npm run validate:bundle",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "expo": "~52.0.46",
    "expo-router": "~4.0.20",
    "expo-status-bar": "~2.0.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^24.2.3",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.4.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "sharp": "^0.33.5",
    "ts-jest": "^29.2.5",
    "typescript": "~5.3.3"
  }
}
