# Copy to .env for local Expo development (restart Expo after changes)
#
# CDN: deploy content/ per docs/DEPLOY-CONTENT.md
# GitHub Pages (this repo): https://raythan.github.io/stickera
# Netlify: https://your-stickera-site.netlify.app
EXPO_PUBLIC_CONTENT_BASE_URL=https://raythan.github.io/stickera
#
# Leave unset to use only the offline bundle (content/ in app binary)
# EXPO_PUBLIC_CONTENT_BASE_URL=
EXPO_PUBLIC_DEFAULT_LOCALE=en
