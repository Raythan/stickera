# Copy to .env for local Expo development (restart Expo after changes)
#
# CDN: deploy content/ per docs/DEPLOY-CONTENT.md
# GitHub Pages (this repo): https://raythan.github.io/stickera
# Netlify: https://your-stickera-site.netlify.app
EXPO_PUBLIC_CONTENT_BASE_URL=https://raythan.github.io/stickera
#
# Leave unset to use only the offline bundle (content/ in app binary)
# EXPO_PUBLIC_CONTENT_BASE_URL=
EXPO_PUBLIC_DEFAULT_LOCALE=en
#
# Admin unlock (optional): SHA-256 hex of your secret phrase — never commit the phrase.
# Generate: node scripts/hash-admin-code.mjs "your-secret-phrase"
# EXPO_PUBLIC_ADMIN_CODE_HASH=
#
# GitHub Actions: repository secret ADMIN_CODE_HASH (same hex value)
#
# Required for trade (register/claim) — local: wrangler dev in workers/trade-registry
# EXPO_PUBLIC_TRADE_REGISTRY_URL=http://localhost:8787
# Production GitHub Actions secret: TRADE_REGISTRY_URL (same value, no trailing slash)
