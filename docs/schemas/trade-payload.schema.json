{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stickera.dev/schemas/trade-payload.schema.json",
  "title": "StickeraTradePayload",
  "oneOf": [
    { "$ref": "#/$defs/payloadV1" },
    { "$ref": "#/$defs/payloadV2" }
  ],
  "$defs": {
    "side": {
      "type": "object",
      "required": ["stickerId", "quantity"],
      "additionalProperties": false,
      "properties": {
        "stickerId": { "type": "string", "minLength": 3 },
        "quantity": { "const": 1 }
      }
    },
    "payloadV1": {
      "type": "object",
      "required": ["v", "offerId", "offered", "wanted", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "offerId": { "type": "string", "format": "uuid" },
        "fromDisplayName": { "type": "string", "maxLength": 40 },
        "offered": { "$ref": "#/$defs/side" },
        "wanted": { "$ref": "#/$defs/side" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "payloadV2": {
      "type": "object",
      "required": ["v", "offerId", "offeredIds", "expiresAt", "contentVersion"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 2 },
        "offerId": { "type": "string", "format": "uuid" },
        "fromDisplayName": { "type": "string", "maxLength": 40 },
        "fromProfileId": { "type": "string", "minLength": 8 },
        "contentVersion": { "type": "string", "minLength": 1 },
        "offeredIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
