{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stickera.dev/schemas/trade-payload.schema.json",
  "title": "StickeraTradePayload",
  "type": "object",
  "required": ["v", "offerId", "offered", "wanted", "expiresAt"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "offerId": { "type": "string", "format": "uuid" },
    "fromDisplayName": { "type": "string", "maxLength": 40 },
    "offered": { "$ref": "#/$defs/side" },
    "wanted": { "$ref": "#/$defs/side" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["stickerId", "quantity"],
      "additionalProperties": false,
      "properties": {
        "stickerId": { "type": "string", "minLength": 3 },
        "quantity": { "const": 1 }
      }
    }
  }
}
